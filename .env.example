# =============================================================================
# HexaLite — variables de entorno
# =============================================================================
# Regla general del framework: CADA PIEZA SE ACTIVA SOLA cuando sus variables
# están llenas. Si no defines Redis, se usa caché en memoria; si no defines
# correo, los mensajes van al log; si no defines Google, ese botón queda apagado.
# Nada de esto rompe el arranque.
# =============================================================================

APP_NAME=MiApp
APP_ENV=local                       # 'production' endurece cookies, oculta errores y enlaces
APP_URL=http://localhost:8000       # base canónica de la API (para url())

# =============================================================================
# BASE DE DATOS
# =============================================================================
# Grupo DB_* → conexión «default». Un grupo cuenta como configurado cuando tiene
# HOST y NAME; si faltan, esa conexión simplemente no se registra.
# El driver se deduce del puerto (5432 → pgsql, 3306 → mysql) salvo que lo fijes.
DB_CONNECTION=pgsql                 # pgsql | mysql | sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=miapp
DB_USER=postgres
DB_PASSWORD=

# Conexiones ADICIONALES (opcionales). Se registran junto a la principal y se
# inyectan con #[Inject('database.mysql')] o database.pgsql.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_NAME=legacy
# MYSQL_USER=root
# MYSQL_PASSWORD=

# =============================================================================
# REDIS (opcional)
# =============================================================================
# Con Redis, el rate limiting y la revocación de sesiones son GLOBALES entre
# workers y máquinas. Sin él, el framework usa memoria del proceso: suficiente
# para desarrollo, inútil como defensa en producción bajo PHP-FPM.
# Necesita ext-redis o predis/predis.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_PREFIX=miapp:
# REDIS_URL=redis://:password@127.0.0.1:6379/0   # alternativa de una sola línea

# =============================================================================
# AUTENTICACIÓN — OBLIGATORIO
# =============================================================================
# Genera cada clave con:  php -r "echo bin2hex(random_bytes(32));"
# Tienen que ser DISTINTAS: con la misma, un access token filtrado serviría
# también como refresh. El framework se niega a arrancar si faltan o coinciden.
JWT_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_TTL=900                  # 15 min
JWT_REFRESH_TTL=604800              # 7 días (30 con "recordarme")

# =============================================================================
# FRONTEND Y COOKIES
# =============================================================================
# Base del front: se usa para construir los enlaces de los correos.
FRONTEND_URL=http://localhost:5173

# Orígenes permitidos por CORS (separados por comas). En cuanto pones una lista
# concreta, se habilitan las credenciales (cookies) para esos orígenes.
FRONTEND_ORIGINS=http://localhost:5173

# Dominio de las cookies. Vacío = host-only (correcto en local). Con el front y
# la API en subdominios distintos: .midominio.com
COOKIE_DOMAIN=
# Por defecto en producción: COOKIE_SECURE=1 y COOKIE_SAMESITE=None.
# COOKIE_SECURE=1
# COOKIE_SAMESITE=None

# =============================================================================
# POLÍTICA DE CONTRASEÑAS Y VERIFICACIÓN
# =============================================================================
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_MIXED_CASE=1
PASSWORD_REQUIRE_NUMBER=1
PASSWORD_REQUIRE_SYMBOL=1

# Verificación BLANDA (por defecto): el usuario entra y ve un aviso.
# A 1 se vuelve DURA: sin correo verificado no se puede iniciar sesión.
AUTH_REQUIRE_VERIFIED_EMAIL=0
AUTH_RESET_TTL_MINUTES=60
AUTH_DEFAULT_ROLES=user

# Rol con acceso total: quien lo tenga pasa el PermissionGuard sin revisar
# permisos puntuales. Vacío = desactivado (y sin consulta extra de roles).
AUTH_SUPER_ROLE=

# Clave para cifrar secretos EN REPOSO con HexaLite\Security\EncryptionService
# (App Passwords de SMTP, tokens de integraciones...). Sin ella se usa JWT_SECRET
# como respaldo. Genera una con: php -r "echo bin2hex(random_bytes(32));"
# OJO: si cambia, los datos ya cifrados dejan de poder descifrarse.
APP_ENCRYPTION_KEY=

# =============================================================================
# CORREO (opcional — sin esto, los correos se escriben en el log)
# =============================================================================
# MAIL_MAILER=smtp                  # smtp | resend | log (si se omite, se deduce)
MAIL_FROM_EMAIL=no-reply@midominio.com
MAIL_FROM_NAME=MiApp

# Opción A — SMTP (cliente nativo incluido, sin dependencias)
# MAIL_HOST=smtp.midominio.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls               # tls (587) | ssl (465) | none

# Opción B — Resend (API HTTP)
# RESEND_API_KEY=

# =============================================================================
# INTEGRACIONES OPCIONALES
# =============================================================================
# «Continuar con Google». El client ID es público (viaja en el front); aquí se
# usa para exigir que el ID token venga emitido para TU app. Necesita ext-openssl.
# GOOGLE_CLIENT_ID=

# reCAPTCHA. En cuanto defines el secreto, el captcha pasa a ser OBLIGATORIO en
# login, registro y forgot-password.
# RECAPTCHA_SECRET=
# RECAPTCHA_MIN_SCORE=0.5

# Dónde cachear el JWKS de Google. Por defecto, el temporal del sistema.
# CACHE_DIR=/var/www/miapp/var/cache
